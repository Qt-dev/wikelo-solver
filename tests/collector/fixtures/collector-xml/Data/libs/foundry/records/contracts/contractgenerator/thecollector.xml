<ContractGenerator.TheCollector>
  <generators>
    <ContractGeneratorHandler_List>
      <Contract id="wikelo-inline" debugName="Wikelo Inline">
        <MissionProperty missionVariableName="HaulingOverride">
          <HaulingOrderContent_EntityClass entityClass="@item_ore" minAmount="2" maxAmount="4" />
        </MissionProperty>
        <contractResults>
          <ContractResult_Item entityClass="@reward_box" amount="1" />
          <ContractResult_Item entityClass="@reward_token" amount="20" />
          <BlueprintRewards blueprintPool="@blueprint_reward">
            <missionResults><Bool value="0" /><Bool value="1" /><Bool value="0" /></missionResults>
          </BlueprintRewards>
          <ContractResult_Item entityClass="@crafted_reward" amount="1" />
        </contractResults>
      </Contract>
      <Contract id="wikelo-fixed" debugName="Wikelo Fixed" template="@fixed_template">
        <contractResults>
          <ContractResult_Item entityClass="@reward_box" amount="1" />
        </contractResults>
      </Contract>
    </ContractGeneratorHandler_List>
  </generators>
</ContractGenerator.TheCollector>
