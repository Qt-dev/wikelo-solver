{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "site",
	"main": "worker/index.ts",
	"compatibility_date": "2026-07-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wikelo-solver-d1",
			"database_id": "7d82c9ac-79a9-4cf8-941f-ef448b4b4bfe",
			"migrations_dir": "./drizzle"
		}
	],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	"triggers": {
		"crons": ["15 */6 * * *", "30 3 * * *"]
	},
	"workflows": [
		{
			"binding": "UEX_SYNC_WORKFLOW",
			"name": "wikelo-uex-sync",
			"class_name": "UexPriceSyncWorkflow"
		},
		{
			"binding": "GAME_SYNC_WORKFLOW",
			"name": "wikelo-game-sync",
			"class_name": "GameDataSyncWorkflow"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "WikeloRepositoryContainer",
				"class_name": "WikeloRepositoryContainer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["WikeloRepositoryContainer"]
		}
	],
	"containers": [
		{
			"class_name": "WikeloRepositoryContainer",
			"image": "./collector/scunpacked-container/Dockerfile",
			"instance_type": "standard-1",
			"max_instances": 1
		}
	],
	"observability": {
		"enabled": true
	}
}
